# Base URL of the Django API.
# Local development: leave this unset and the Vite dev-server proxy forwards
# /api/* to http://127.0.0.1:8090 (see vite.config.js). Run the backend on 8090.
#
# Production: set this to the deployed backend origin, e.g.
#   VITE_API_BASE_URL=https://spotter-eld-api-rose.vercel.app/api/v1
VITE_API_BASE_URL=
